# ── Database ──────────────────────────────────────────────────────────────────
# Either set DATABASE_URL (overrides all PGXXX vars) or set the individual vars.
DATABASE_URL=postgres://astraledger:astraledger@localhost:5432/astraledger_indexer
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=astraledger_indexer
# PGUSER=astraledger
# PGPASSWORD=astraledger
# PG_POOL_MAX=10

# ── Stellar RPC ────────────────────────────────────────────────────────────────
# Soroban RPC endpoint for your target network.
RPC_URL=https://soroban-testnet.stellar.org
# STELLAR_NETWORK=testnet
# NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# ── Contracts to index ─────────────────────────────────────────────────────────
# Comma-separated list of "label:contractId" pairs.
# Example: CONTRACT_IDS=rwa:CABC...,kyc:CDEF...,compliance:CGHI...
CONTRACT_IDS=

# ── Poller ─────────────────────────────────────────────────────────────────────
# How often (in milliseconds) each contract is polled for new events.
POLL_INTERVAL_MS=5000

# ── HTTP API ───────────────────────────────────────────────────────────────────
PORT=3001
