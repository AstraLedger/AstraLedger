{
  "name": "@astraledger/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for AstraLedger smart contracts on Stellar Soroban",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "homepage": "https://github.com/Muyideen-js/Veritoken/tree/main/sdk#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Muyideen-js/Veritoken",
    "directory": "sdk"
  },
  "versioningPolicy": "sdk/VERSIONING.md",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:client": "node scripts/generate-client.mjs"
  },
  "peerDependencies": {
    "@stellar/stellar-sdk": ">=12.0.0"
  },
  "devDependencies": {
    "@stellar/stellar-sdk": "^12.3.0",
    "call-bound": "^1.0.4",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0",
    "which-typed-array": "^1.1.22"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "stellar",
    "soroban",
    "rwa",
    "astraledger",
    "kyc",
    "compliance"
  ],
  "license": "MIT"
}
